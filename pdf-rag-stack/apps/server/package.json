    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.4.0",
    "express-session": "1.18.0",
    "helmet": "7.1.0",
    "multer": "1.4.5-lts.1",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "pdfjs-dist": "4.6.82",
    "pino": "8.17.2",
    "pino-http": "8.6.1",
