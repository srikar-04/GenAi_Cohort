    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/multer": "1.4.11",
    "@types/node": "20.14.10",
    "@types/passport": "1.0.17",
    "@types/passport-github2": "1.2.5",
    "@types/passport-google-oauth20": "2.0.14",
    "@types/compression": "1.7.5",
    "@types/helmet": "4.0.0",
    "prisma": "5.18.0",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
